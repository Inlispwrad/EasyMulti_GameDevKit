<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match EasyMulti.Protocol: netstandard2.1 + C# 9 is what Unity 2021.3 LTS
         and newer can compile from source, and every .NET 6+ host (Godot 4.x, MonoGame,
         Stride, plain .NET) can consume. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <!-- Implicit usings emit `global using`, which is C# 10. Every file declares its own. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EasyMultiNet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EasyMulti.Protocol/EasyMulti.Protocol.csproj" />
  </ItemGroup>

</Project>
